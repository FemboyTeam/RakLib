{
	"name": "femboyteam/raklib",
	"description": "A RakNet server implementation written in PHP",
	"type": "library",
	"license": "GPL-3.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/FemboyTeam/Log"
        },
        {
            "type": "vcs",
            "url": "https://github.com/FemboyTeam/BinaryUtils"
        }
    ],
	"require": {
		"php": "^8.0",
		"php-ipv6": "*",
		"php-64bit": "*",
		"ext-sockets": "*",
		"femboyteam/log": "^0.3.0 || ^0.4.0",
		"femboyteam/binaryutils": "^0.2.0"
	},
	"require-dev": {
		"phpstan/phpstan": "1.9.17",
		"phpstan/phpstan-strict-rules": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"raklib\\": "src/"
		}
	}
}
